# Optional client settings (Vite reads VITE_* variables at build time).

# WebSocket relay used for online play. Defaults to /ws on the same host that serves the
# game, so you only need this when the client is hosted separately from `npm start`
# (e.g. a static deploy), for example: wss://your-server.example.com/ws
VITE_RELAY_URL=

# URL returning extra WebRTC ICE servers (JSON array or { iceServers: [...] }) for the
# peer-to-peer fallback used when no relay server is reachable.
VITE_TURN_CREDENTIALS_URL=

# Server port for `npm run dev` / `npm start` (Render and similar hosts set this).
PORT=3000
